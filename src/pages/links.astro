      },
      {
        name: 'TrickyStore',
        url: 'https://github.com/5ec1cff/TrickyStore',
        desc: '处理 Android 硬件密钥认证的模块。',
      },
      {
        name: 'PlayIntegrityFix',
        url: 'https://github.com/KOWX712/PlayIntegrityFix',
        desc: '修复 Play Integrity 校验的模块。',
      },
    ],
  },
  {
    name: '开发与工具',
    desc: '写代码、查文档时常用的站点。',
    links: [
      {
        name: 'GitHub',
        url: 'https://github.com',
        desc: '代码托管与协作平台，几乎所有开源项目的家。',
      },
      {
        name: 'MDN Web Docs',
        url: 'https://developer.mozilla.org',
        desc: 'Web 技术文档的权威来源，查 HTML/CSS/JS 首选。',
      },
      {
        name: 'Can I use',
        url: 'https://caniuse.com',
        desc: '查询浏览器特性支持情况，兼容性问题一查便知。',
      },
