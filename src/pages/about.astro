---
import Base from '../layouts/Base.astro';
---

<Base title="关于">
  <h1 class="page-title">关于</h1>
  <p class="page-desc">关于我，以及这个站点。</p>

  <div class="prose">
    <p>你好，我是张怀民。这里是我的个人站点，放一些笔记，以及平时收集的链接。</p>
    <p>本站点托管在 Cloudflare Pages。没有评论系统，没有追踪脚本，打开速度尽可能快。</p>
    <p>
      如果你有话想说，欢迎给我发邮件：<a
        href="mailto:roczhm@gmail.com"
        class="mail-link"
        id="mail-link">roczhm@gmail.com</a
      >
    </p>
  </div>

  <div class="mail-toast" id="mail-toast" hidden></div>

  <script>
    const link = document.getElementById('mail-link');
    const toast = document.getElementById('mail-toast');
    let timer = 0;
    link?.addEventListener('click', async (e) => {
      e.preventDefault();
      const addr = 'roczhm@gmail.com';
      try {
        await navigator.clipboard.writeText(addr);
        if (toast) toast.textContent = '已复制 ' + addr;
      } catch {
        if (toast) toast.textContent = addr;
      }
      if (toast) toast.hidden = false;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (toast) toast.hidden = true;
      }, 2600);
    });
  </script>
</Base>
